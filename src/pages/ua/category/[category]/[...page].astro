---
import type { GetStaticPathsOptions } from "astro";

import { categoryPaths } from "../../../../utils/posts";
import Listing from "../../../../views/Listing.astro";

export const getStaticPaths = ({ paginate }: GetStaticPathsOptions) => categoryPaths("ua", paginate);

const { page, heading } = Astro.props;
---

