    h1 { font-size: 20px !important; }
    h2 { font-size: 16px !important; }
    h3 { font-size: 14px !important; }
    h4 { font-size: 12px !important; }
    ul { list-style-type: square !important; }
    li { padding-left: 0 !important; }
  }
</style>
