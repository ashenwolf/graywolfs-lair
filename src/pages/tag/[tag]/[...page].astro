---
import type { GetStaticPathsOptions } from "astro";

import { tagPaths } from "../../../utils/posts";
import Listing from "../../../views/Listing.astro";

export const getStaticPaths = ({ paginate }: GetStaticPathsOptions) => tagPaths("en", paginate);

const { page, heading } = Astro.props;
---

<Listing lang="en" heading={heading} page={page} />
