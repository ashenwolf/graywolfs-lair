---
import type { Page } from "astro";

import ArticleCard from "../components/ArticleCard.astro";
import Pagination from "../components/Pagination.astro";
import Base from "../layouts/Base.astro";
import type { Lang } from "../constants/site";
import type { Post } from "../utils/posts";

interface Props {
  lang: Lang;
  heading: string;
  page: Page<Post>;
}

const { lang, heading, page } = Astro.props;
---

<Base title={heading} lang={lang}>
  <div class="container-inner">
    <h1 class="text-3xl font-bold mb-8">{heading}</h1>
    <ul class="divide-y divide-gray-100">
      {page.data.map((post) => (
        <li class="py-6 first:pt-0 last:pb-0">
          <ArticleCard post={post} lang={lang} />
        </li>
      ))}
    </ul>
    <Pagination page={page} lang={lang} />
  </div>
</Base>
