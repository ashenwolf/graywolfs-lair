---
import SocialLinks from "./SocialLinks.astro";
import { LOCALES, SITE, type Lang } from "../constants/site";
import { formatDate } from "../utils/date";
import { loadPosts } from "../utils/posts";
import { nav } from "../utils/urls";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { ui } = LOCALES[lang];
const { links, toggle } = nav(lang);
const recent = (await loadPosts(lang)).slice(0, 2);
---

<footer class="border-t border-gray-200 mt-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-8 py-12 grid grid-cols-1 md:grid-cols-3 gap-10">
    <!-- Navigation -->
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-4">
        {ui.navigation}
      </h3>
      <ul class="space-y-2">
        {
          [...links, toggle].map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-gray-600 hover:text-gray-900 transition-colors">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Recent posts -->
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-4">
        {ui.recentPosts}
      </h3>
      <ul class="space-y-4">
        {
          recent.map(({ url, title, date }) => (
            <li>
              <a href={url} class="text-sm text-gray-700 hover:text-gray-900 leading-snug block font-medium">
                {title}
              </a>
              <time class="text-xs text-gray-400 mt-0.5 block">{formatDate(date, lang, "month")}</time>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Social -->
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-4">
        {ui.social}
      </h3>
      <SocialLinks />
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-8 py-4 flex items-center justify-between">
      <p class="text-xs text-gray-400">
        &copy; 2004-{new Date().getFullYear()} {SITE.author}
      </p>
      <a href="#top" class="text-xs text-gray-400 hover:text-gray-700 flex items-center gap-1.5 transition-colors">
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 19V5M5 12l7-7 7 7"></path>
        </svg>
        {ui.backToTop}
      </a>
    </div>
  </div>
</footer>
