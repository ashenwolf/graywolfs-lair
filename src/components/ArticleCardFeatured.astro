---
import type { Lang } from "../constants/site";
import { onClick } from "../utils/analytics";
import { formatDate } from "../utils/date";
import type { Post } from "../utils/posts";

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { url, title, date, category, cover } = post;
---

<a href={url} class="group block" {...onClick("article_card_clicked", { title, category: category?.id, href: url })}>
  <div class="aspect-video rounded-xl overflow-hidden mb-3 bg-surface">
    {cover ? (
      <img
        src={cover}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    ) : (
      <div class={`w-full h-full bg-gradient-to-br ${category?.gradient ?? "from-gray-300 to-gray-400"}`}></div>
    )}
  </div>

  <div class="flex items-center gap-2 mb-1">
    {category && (
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">{category.label}</span>
    )}
    <time class="text-xs text-gray-400" datetime={date.toISOString()}>
      {formatDate(date, lang)}
    </time>
  </div>

  <h3 class="font-bold text-gray-900 leading-snug group-hover:text-accent transition-colors">
    {title}
  </h3>
</a>
