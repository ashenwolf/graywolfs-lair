---
import { SITE, type Lang } from "../constants/site";
import { crossDomainHref, localPath, nav, PROD_HOSTS } from "../utils/urls";
import { onClick } from "../utils/analytics";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { links, toggle } = nav(lang);
const toggleAttrs = {
  "data-prod-href": crossDomainHref(lang, Astro.url.pathname),
  ...onClick("language_switched", { to_lang: toggle.lang }),
};
---

<header class="border-b border-gray-200 py-4">
  <nav class="max-w-5xl mx-auto px-4 sm:px-8 flex items-center justify-between">

    <!-- Logo + site title -->
    <a href={localPath(lang)} class="flex-shrink-0 flex items-center gap-2">
      <img
        src="/favicon.png"
        alt={SITE.author}
        width="32"
        height="32"
        class="rounded-full"
      />
      <span class="font-semibold text-gray-900 text-xl sm:text-2xl">{SITE.author}</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden sm:flex items-center gap-8">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class="text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors"
        >
          {label}
        </a>
      ))}
      <a
        href={toggle.href}
        {...toggleAttrs}
        class="text-sm font-medium px-3 py-1 rounded border border-gray-300 text-gray-600 hover:bg-gray-100 transition-colors"
      >
        {toggle.label}
      </a>
    </div>

    <!-- Mobile: language toggle + hamburger -->
    <div class="flex items-center gap-2 sm:hidden">
      <a
        href={toggle.href}
        {...toggleAttrs}
        class="text-sm font-medium px-3 py-1 rounded border border-gray-300 text-gray-600 hover:bg-gray-100 transition-colors"
      >
        {toggle.label}
      </a>
      <button
        id="mobile-menu-btn"
        class="flex flex-col justify-center gap-1.5 w-8 h-8 focus:outline-none"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="block h-0.5 w-6 bg-gray-700 transition-all"></span>
        <span class="block h-0.5 w-6 bg-gray-700 transition-all"></span>
        <span class="block h-0.5 w-6 bg-gray-700 transition-all"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile dropdown -->
  <div
    id="mobile-menu"
    class="sm:hidden hidden flex-col px-4 pt-3 pb-4 gap-3 border-t border-gray-100 mt-4"
  >
    {links.map(({ href, label }) => (
      <a
        href={href}
        class="text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors py-1"
      >
        {label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    menu?.classList.toggle("flex", open);
    btn.setAttribute("aria-expanded", String(open));
  });
</script>

{/* Only on the live domains: dev and preview deploys keep the relative toggle link. */}
<script is:inline define:vars={{ hosts: PROD_HOSTS }}>
  if (hosts.includes(location.hostname))
    document.querySelectorAll("[data-prod-href]").forEach((el) => (el.href = el.dataset.prodHref));
</script>
