---
import ArticleCardFeatured from "./ArticleCardFeatured.astro";
import { LOCALES, type Lang } from "../constants/site";
import { onClick } from "../utils/analytics";
import type { Post } from "../utils/posts";

interface Props {
  title: string;
  blurb: string;
  href: string;
  posts: Post[];
  lang: Lang;
}

const { title, blurb, href, posts, lang } = Astro.props;
const { ui } = LOCALES[lang];
---

<section class="py-12">
  <div class="border-t border-gray-200 mb-10"></div>

  <div class="flex flex-col md:flex-row gap-10">
    <!-- Left 1/3 -->
    <div class="md:w-1/3 flex-shrink-0">
      <h2 class="text-2xl font-bold mb-3">{title}</h2>
      <p class="text-sm text-gray-600 leading-relaxed mb-5">{blurb}</p>
      <a href={href} class="text-sm font-semibold text-accent hover:underline" {...onClick("category_more_clicked", { section: title, href })}>
        {ui.seeMore} →
      </a>
    </div>

    <!-- Right 2/3: 2×2 grid -->
    <div class="flex-1">
      {posts.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {posts.map((post) => <ArticleCardFeatured post={post} lang={lang} />)}
        </div>
      ) : (
        <p class="text-sm text-gray-400">{ui.noArticlesInCategory}</p>
      )}
    </div>
  </div>
</section>
