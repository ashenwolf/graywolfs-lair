---
import ArticleCard from "./ArticleCard.astro";
import type { ArticleWithUrl } from "../utils/articleUrls";
import type { Lang } from "../constants/labels";

interface Props {
  articles: ArticleWithUrl[];
  emptyMessage?: string;
  lang?: Lang;
}

const { articles, emptyMessage = "No articles yet.", lang = "en" } = Astro.props;
---

{articles.length === 0 && <p class="text-gray-500">{emptyMessage}</p>}
<ul class="divide-y divide-gray-100">
  {articles.map((article) => (
    <li class="py-6 first:pt-0 last:pb-0">
      <ArticleCard
        href={article.url}
        title={article.data.title}
        date={article.data.date}
        description={article.data.description}
        tags={article.data.tags}
        image={article.data.image}
        lang={lang}
      />
    </li>
  ))}
</ul>
