---
import type { Lang } from "../constants/site";
import { formatDate } from "../utils/date";
import type { Post } from "../utils/posts";

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { url, title, date, tags, cover } = post;
---

<a href={url} class="group flex flex-col sm:flex-row gap-4 sm:gap-6 items-start">
  <div class="w-full sm:w-48 sm:shrink-0 aspect-video rounded-lg overflow-hidden bg-gray-100">
    {cover ? (
      <img
        src={cover}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full bg-gray-200" />
    )}
  </div>

  <div class="flex-1 min-w-0">
    <time class="text-xs text-gray-400" datetime={date.toISOString()}>
      {formatDate(date, lang)}
    </time>
    <h2 class="text-lg font-semibold leading-snug group-hover:text-accent transition-colors mt-1 mb-2">
      {title}
    </h2>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map(({ name }) => (
          <span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded">{name}</span>
        ))}
      </div>
    )}
  </div>
</a>
