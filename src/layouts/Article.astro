---
import Base from "./Base.astro";
import { onClick, onView } from "../utils/analytics";
import { formatDate } from "../utils/date";
import type { Post } from "../utils/posts";

interface Props {
  post: Post;
}

const { title, date, tags, lang, category, cover, description } = Astro.props.post;
const readEvent = onView("article_read", { title, category: category?.id, tags: tags.map(({ name }) => name), lang });
---

<Base title={title} lang={lang} description={description} image={cover}>
  <article class="max-w-3xl mx-auto px-4 sm:px-8 py-12" {...readEvent}>
    <header class="mb-8">
      {
        category && (
          <span class="text-xs font-semibold uppercase tracking-wider text-accent block mb-2">
            {category.label}
          </span>
        )
      }
      <h1 class="text-3xl font-bold mb-2">{title}</h1>
      <time class="text-sm text-gray-500" datetime={date.toISOString()}>
        {formatDate(date, lang, "long")}
      </time>
      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {tags.map(({ name, href }) => (
              <a
                href={href}
                class="text-sm bg-gray-100 px-2 py-0.5 rounded hover:bg-gray-200 transition-colors"
                {...onClick("tag_clicked", { tag: name, article_title: title })}
              >
                {name}
              </a>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose prose-gray max-w-none prose-code:text-[0.85em] prose-pre:text-[0.85em] prose-pre:leading-snug">
      <slot />
    </div>
  </article>
</Base>
